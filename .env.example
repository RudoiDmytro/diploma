# ─────────────────────────────────────────────────────────────
# Copy this file to `.env` and fill in real values.
#   cp .env.example .env
# ─────────────────────────────────────────────────────────────

# ── Database (PostgreSQL) ────────────────────────────────────
# Local (running Postgres on the host):
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/diploma?schema=public"
# When running via docker compose the app talks to the `db` service instead:
#   DATABASE_URL="postgresql://postgres:postgres@db:5432/diploma?schema=public"

# ── NextAuth ─────────────────────────────────────────────────
# Generate a secret with:  openssl rand -base64 32
NEXTAUTH_SECRET="change-me-with-openssl-rand-base64-32"
# Public base URL used by the app for auth callbacks/links.
NEXT_PUBLIC_NEXTAUTH_URL="http://localhost:3000"

# ── OAuth providers ──────────────────────────────────────────
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# ── Bytescale (file uploads, see src/app/api/file/route.ts) ──
# NOTE: the code reads this as the lowercase `apiKey` env var.
apiKey=""

# ── Vercel Blob (optional, only if @vercel/blob uploads are used) ──
# BLOB_READ_WRITE_TOKEN=""

# ── Runtime (optional) ───────────────────────────────────────
# PORT=3000
